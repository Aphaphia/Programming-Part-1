# test run
name: Validate Repository Structure

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]


jobs:
  validate-docs:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check docs folder exists
        run: |
          if [ ! -d "docs" ]; then
            echo "ERROR: docs folder is missing"
            exit 1
          fi
          echo "docs folder found"

      - name: Check required planning files exist
        run: |
          test -f docs/raceday_erd.pdf || (echo "ERROR: Missing ERD file" && exit 1)
          test -f docs/api_endpoint_plan.md || (echo "ERROR: Missing endpoint plan" && exit 1)
          test -f docs/schema.sql || (echo "ERROR: Missing SQL script" && exit 1)
          echo "All required planning files are present"
